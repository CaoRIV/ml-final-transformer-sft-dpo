# Secrets
.env
.env.*
!.env.example
*.pem
*.key
/token.json
/credentials.json

# Python and notebook runtime
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/
.cache/

# Private data: only explicitly shareable samples belong in Git
/data/*
!/data/samples/
/private/
/consent/
/surveys_raw/

# Large models and training artifacts
/checkpoints/
/models/
/outputs/
/runs/
/wandb/
/environment_checks/
*.safetensors
*.pt
*.pth
*.ckpt
*.bin

# Local editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# LaTeX build artifacts
*.aux
*.log
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz

# Future reference PDFs stay local pending redistribution review.
# Already tracked PDFs are NOT removed by this rule.
/references/*.pdf
